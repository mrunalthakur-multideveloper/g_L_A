# =================================================================
# ApplyUs ATS Job Scraper & CRM Pipeline Configuration
# =================================================================

# 1. Neon PostgreSQL Database Configuration (Required for DB Sync)
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_TABLE=links

# 2. ApplyUs CRM Endpoint Configuration (Required for Active Clients)
CRM_BACKEND_URL=https://api.applyus.org
INTERNAL_SERVICE_API_KEY=your_internal_service_api_key_here
CRM_API_KEY=your_crm_api_key_here

# 3. Scraping Configuration
HOURS_WINDOW=24
SCRAPING_WORKERS=25

# Optional: Specific Target Date (YYYY-MM-DD)
# TARGET_DATE=2026-09-25

# Optional: Proxy (Leave empty to use direct connection)
# PROXY_URL=
